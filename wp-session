#!/bin/sh
# Remote command for waypipe inside the container.
# Writes this session's WAYLAND_DISPLAY/DISPLAY to a file that host apps can
# source, then runs the given command, or just keeps the session open.
f="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR not set}/waypipe-session.env"
{
  echo "export WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
  [ -n "$DISPLAY" ] && echo "export DISPLAY=$DISPLAY"
} > "$f"
trap 'rm -f "$f"' EXIT
trap 'exit 0' HUP INT TERM

if [ $# -gt 0 ]; then
  "$@"
else
  # Keep the session alive for apps launched from the host.
  while :; do sleep 3600 & wait $!; done
fi
